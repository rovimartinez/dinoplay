{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "juegodino",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-08-23",
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGIN": "https://juegodino.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinoplay-db",
      "database_id": "5d8b9d69-25a7-4d87-b078-e680b029a150",
      "migrations_dir": "./migrations"
    }
  ]
}
